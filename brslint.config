{
    "paths": {
        "include": [
            "source",
            "components"
        ],
        "exclude": [
            "legacy",
            "node_modules",
            ".git",
            "roku-template",
            "build",
            "demos",
            "out",
            ".roku-staging"
        ]
    },
    "rules": {
        "include": [
            "no_empty_then",
            "no_empty_else",
            "function_too_big",
            "function_type"
        ]
    }
}
