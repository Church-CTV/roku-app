' ConfigLoader.bs - Configuration loading, validation, and runtime access
' Provides a centralized config system for the Roku App Template Service
' Businesses customize config/default.json without modifying core code

' Load configuration from JSON file
' Returns roAssociativeArray or invalid on failure
function LoadConfig (configPath) as object
    if configPath = invalid or configPath = ""
        configPath = "pkg:/config/default.json"
    end if

    rsp = ReadAsciiFile(configPath)
    if rsp = invalid or rsp = ""
        LogError("ConfigLoader", "Failed to read config file: " + configPath)
        return LoadDefaultConfig()
    end if

    config = invalid
    try
        config = ParseJson(rsp)
    catch e
        LogError("ConfigLoader", "ParseJson failed: " + e.message)
        config = invalid
    end try
    if config = invalid or Type(config) <> "roAssociativeArray"
        LogError("ConfigLoader", "Failed to parse config JSON: " + configPath)
        return LoadDefaultConfig()
    end if

    ' Validate the loaded config
    validationErrors = ValidateConfig(config)
    if validationErrors.Count() > 0
        LogError("ConfigLoader", "Config validation errors:")
        for each err in validationErrors
            LogError("ConfigLoader", "  - " + err)
        end for
        ' Merge with defaults to ensure all fields exist
        defaults = LoadDefaultConfig()
        config = MergeConfig(defaults, config)
    end if

    LogInfo("ConfigLoader", "Configuration loaded successfully: " + configPath)
    return config
end function

' Load embedded default configuration (fallback)
