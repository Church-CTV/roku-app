    LogInfo("ConfigLoader", "Loading embedded default configuration")
    defaults = {
        version: "1.0.0"
        channel: {
            name: "Roku Channel"
            description: "Roku App Template Service"
            language: "en"
            copyright: ""
        }
        branding: {
            colors: {
                background: "0x1A1A2E"
                surface: "0x16213E"
                accent: "0xE8B931"
                textPrimary: "0xFFFFFF"
                textSecondary: "0xA0A0B0"
                focus: "0xE8B931"
                navFocusBg: "0xE8B931"
                error: "0xFF4444"
            }
            images: {
                overhangLogo: "pkg:/images/hd_overhang_logo.png"
                backgroundImage: "pkg:/images/background.png"
                iconFocus: "pkg:/images/icon_focus_hd.png"
                liveStreamThumbnail: "pkg:/images/live-thumb.png"
                liveStreamUrl: ""
            }
            fonts: {
                title: "font:BoldSystemFont"
                body: "font:MediumSystemFont"
                caption: "font:SmallSystemFont"
                heading: "font:ExtraBoldSystemFont"
            }
            spacing: {
                marginHorizontal: 80
                marginVertical: 40
            }
            animation: {
                cardScale: 1.05
                transitionDuration: 0.25
            }
        }
        content: {
            sourceUrl: ""
            userAgent: "Roku/Template"
            maxRows: 6
            maxItemsPerRow: 12
            retryAttempts: 3
            retryDelayMs: 2000
            fetchTimeout: 30
            sslCertificates: "common:/certs/ca-bundle.crt"
        }
        features: {
            search: true
            deepLinking: true
            analytics: true
            crashReporting: true
            layoutPreference: "leftnav"
            overhangLogo: true
            overhangClock: true
            overhangOptions: true
        }
        ui: {
            backgroundColor: "0x1A1A2E"
            welcome: {
                enabled: true
                title: "Loading..."
                subtitle: "Please wait"
            }
            error: {
                title: "Connection Error"
