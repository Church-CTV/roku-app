{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Roku Channel Configuration",
  "type": "object",
  "properties": {
    "version": { "type": "string" },
    "channel": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "language": { "type": "string" },
        "copyright": { "type": "string" }
      },
      "required": ["name"]
    },
    "branding": {
      "type": "object",
      "properties": {
        "colors": {
          "type": "object",
          "properties": {
            "background": { "type": "string" },
            "surface": { "type": "string" },
            "accent": { "type": "string" },
           "textPrimary": { "type": "string" },
            "textSecondary": { "type": "string" },
            "focus": { "type": "string" },
            "navFocusBg": { "type": "string" },
            "error": { "type": "string" }
          }
        },
        "images": {
          "type": "object",
          "properties": {
            "overhangLogo": { "type": "string" },
            "backgroundImage": { "type": "string" },
            "iconFocus": { "type": "string" },
            "liveStreamThumbnail": { "type": "string" }
          }
        },
        "fonts": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "body": { "type": "string" },
            "caption": { "type": "string" },
            "heading": { "type": "string" }
          }
        },
        "spacing": {
          "type": "object",
          "properties": {
            "marginHorizontal": { "type": "integer" },
            "marginVertical": { "type": "integer" }
          }
        },
        "animation": {
          "type": "object",
          "properties": {
            "cardScale": { "type": "number" },
            "transitionDuration": { "type": "number" }
          }
        }
      }
    },
    "content": {
      "type": "object",
      "properties": {
        "sourceUrl": { "type": "string", "format": "uri" },
        "userAgent": { "type": "string" },
        "maxRows": { "type": "integer" },
        "maxItemsPerRow": { "type": "integer" },
        "retryAttempts": { "type": "integer" },
        "retryDelayMs": { "type": "integer" },
        "fetchTimeout": { "type": "integer" },
        "sslCertificates": { "type": "string" }
      },
      "required": ["sourceUrl"]
    },
    "features": {
      "type": "object",
      "properties": {
        "layoutPreference": { "type": "string", "enum": ["grid", "leftnav", "list", "pagebased", "videoplayer", "category", "hybrid", "topnav"] },
        "search": { "type": "boolean" },
        "deepLinking": { "type": "boolean" },
        "analytics": { "type": "boolean" },
        "crashReporting": { "type": "boolean" },
        "overhangLogo": { "type": "boolean" },
        "overhangClock": { "type": "boolean" },
        "overhangOptions": { "type": "boolean" }
      }
    },
    "ui": {
      "type": "object",
      "properties": {
        "backgroundColor": { "type": "string" },
        "welcome": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "title": { "type": "string" },
            "subtitle": { "type": "string" }
          }
        },
        "error": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "message": { "type": "string" },
            "retryLabel": { "type": "string" }
          }
        },
        "loading": {
          "type": "object",
          "properties": {
            "message": { "type": "string" }
          }
        }
      }
    },
    "analytics": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "exportUrl": { "type": "string", "format": "uri" },
        "exportIntervalSeconds": { "type": "integer" },
        "maxEventsPerBatch": { "type": "integer" },
        "flushOnError": { "type": "boolean" }
      }
    },
    "cardStyle": {
      "type": "object",
      "properties": {
        "showTitle": { "type": "boolean" },
        "showDescription": { "type": "boolean" },
        "titleFont": { "type": "string" },
        "descriptionFont": { "type": "string" },
        "titleColor": { "type": "string" },
        "descriptionColor": { "type": "string" },
        "titleNumLines": { "type": "integer" },
        "descriptionNumLines": { "type": "integer" },
        "showDetailTitle": { "type": "boolean" },
        "showDetailDescription": { "type": "boolean" },
        "detailTitleFont": { "type": "string" },
        "detailDescriptionFont": { "type": "string" },
        "detailTitleColor": { "type": "string" },
        "detailDescriptionColor": { "type": "string" },
        "detailTitleNumLines": { "type": "integer" },
        "detailDescriptionNumLines": { "type": "integer" }
      }
    },
    "server": {
      "type": "object",
      "properties": {
        "baseUrl": { "type": "string", "format": "uri" },
        "timeout": { "type": "integer" }
      }
    },
    "navItems": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "icon": { "type": "string" },
          "page": { "type": "string" },
          "visible": { "type": "boolean" },
          "order": { "type": "integer" }
        },
        "required": ["id", "label"]
      }
    },
    "pageRegistry": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "component": { "type": "string" },
          "title": { "type": "string" },
          "requiresAuth": { "type": "boolean" }
        },
        "required": ["component"]
      }
    }
  },
  "required": ["channel", "content"]
}
